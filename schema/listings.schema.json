{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://farmdirect-b2b.example/schema/listings.schema.json",
  "title": "FarmDirect B2B Listing",
  "description": "Canonical listing shape for the map-first B2B marketplace.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "location",
    "visibility",
    "address",
    "sellerid",
    "category",
    "headerdescription",
    "price",
    "units",
    "description",
    "image"
  ],
  "properties": {
    "id": { "type": "string", "description": "Optional client/server id" },
    "location": {
      "type": "object",
      "required": ["lat", "long"],
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "long": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "visibility": {
      "type": "string",
      "enum": ["worldwide", "country", "province"]
    },
    "address": { "type": "string", "minLength": 1 },
    "sellerid": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "headerdescription": { "type": "string", "minLength": 1, "maxLength": 120 },
    "price": { "type": "number", "minimum": 0 },
    "units": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "image": { "type": "string", "format": "uri" }
  }
}
